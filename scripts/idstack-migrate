#!/usr/bin/env bash
# Migrate .idstack/project.json to the latest schema version.
# The script reads the manifest and applies the necessary migrations. It writes
# the manifest again only when it applies a migration. It writes the manifest
# to stdout, changed or not.
# When it applies a migration, it writes "MIGRATED <from> <to>" to stderr.
# If a newer idstack wrote the manifest (its version is above LATEST_VERSION),
# the script writes "NEWER_SCHEMA <version>" to stderr and does not change it.
# If there is no file, the script writes no output and exits 0.
# If python3 is not available, the script exits 3 and changes nothing.
# With --init, if the folder that holds .idstack/ is the home folder, the
# script makes nothing and exits 9.
# If it cannot write the manifest, it writes nothing to stdout, does not
# change the manifest and exits 1.
#
# Usage:
#   idstack-migrate [--init] [path]
#
#   --init   If there is no manifest, make a manifest that has each top-level
#            section. If there is a manifest, migrate it.
#            scripts/idstack-manifest-merge --create uses this flag, so a skill
#            that runs without the pipeline has a manifest on its first run.
#            That tool replaces one or more sections. Without --create, it
#            exits 4 when there is no manifest.
#
# To make the --init manifest, the script writes a small v1.0 document and
# applies the usual migrations to it. The v1.0 document starts context,
# needs_analysis and learning_objectives as empty objects. The migrations add
# the other sections with their default fields. The result does not have the
# full shape in templates/manifest-schema.md.

set -e

LATEST_VERSION="1.4"

INIT=0
MANIFEST=""
for arg in "$@"; do
  case "$arg" in
    --init) INIT=1 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo "idstack-migrate: unknown flag: $arg" >&2; exit 2 ;;
    *) [ -z "$MANIFEST" ] && MANIFEST="$arg" ;;
  esac
done

command -v python3 &>/dev/null || { echo "idstack-migrate: python3 is necessary" >&2; exit 3; }
MANIFEST="${MANIFEST:-.idstack/project.json}"

# Seed a fresh manifest when asked. The seed gives the v1.0 sections as empty
# objects. The migration chain below adds the other sections.
if [ ! -f "$MANIFEST" ] && [ "$INIT" = "1" ]; then
  # The folder that holds .idstack/ must not be the home folder: the global
  # profile is in ~/.idstack/.
  if python3 -c "
import os, sys
folder = os.path.dirname(os.path.dirname(os.path.abspath(sys.argv[1])))
sys.exit(0 if os.environ.get('HOME') and os.path.realpath(folder) == os.path.realpath(os.environ['HOME']) else 1)
" "$MANIFEST"; then
    echo "idstack-migrate: this folder is your home folder. idstack does not make a course manifest here. Go to a course folder, then run the skill again." >&2
    exit 9
  fi
  mkdir -p "$(dirname "$MANIFEST")"
  python3 -c "
import json, os, sys, datetime, tempfile
ts = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
seed = {
    'version': '1.0',
    'project_name': '',
    'created': ts,
    'updated': ts,
    'context': {},
    'needs_analysis': {},
    'learning_objectives': {},
}
# Tempfile and rename, so a failed write cannot leave a cut seed. mkstemp makes
# the file 0600, so give it the mode that the umask allows, as a new report has.
real = os.path.realpath(sys.argv[1])
fd, tmp = tempfile.mkstemp(prefix='.manifest-init.', suffix='.tmp', dir=os.path.dirname(real))
try:
    with os.fdopen(fd, 'w') as f:
        json.dump(seed, f, indent=2)
        f.write('\n')
    umask = os.umask(0)
    os.umask(umask)
    os.chmod(tmp, 0o666 & ~umask)
    os.replace(tmp, real)
except BaseException:
    os.unlink(tmp)
    raise
" "$MANIFEST"
  echo "INITIALIZED $MANIFEST" >&2
fi

# Nothing to do if no manifest exists
[ -f "$MANIFEST" ] || exit 0

# The path goes in through the environment, not into the python source, so a
# path with a quote in it cannot break the program.
VERSION=$(MANIFEST="$MANIFEST" python3 -c "
import json, os, sys
try:
    with open(os.environ['MANIFEST']) as f:
        data = json.load(f)
    print(data.get('version', ''))
except Exception:
    sys.exit(1)
" 2>/dev/null) || { cat "$MANIFEST"; exit 0; }

# Already at latest — just output and exit
if [ "$VERSION" = "$LATEST_VERSION" ]; then
  cat "$MANIFEST"
  exit 0
fi

# Chained migration: apply each step sequentially. On a failure, print nothing to
# stdout and exit 1: the preamble then prints the manifest, which did not change.
MANIFEST="$MANIFEST" python3 -c "
import json, os, shutil, sys, tempfile

MANIFEST = os.environ['MANIFEST']
with open(MANIFEST) as f:
    data = json.load(f)

version = data.get('version', '')
migrated_from = version

def newer(v):
    try:
        return tuple(int(p) for p in str(v).split('.')) > tuple(int(p) for p in '$LATEST_VERSION'.split('.'))
    except ValueError:
        return False

if newer(version):
    print(f'NEWER_SCHEMA {version}', file=sys.stderr)

# A null section is treated as absent, so a migration step can fill its defaults.
data = {k: v for k, v in data.items() if v is not None}

def migrate_1_0_to_1_1(data):
    data.setdefault('assessments', {'items': [], 'formative_checkpoints': [], 'feedback_quality_score': 0})
    data.setdefault('course_content', {'modules': [], 'generated_files': [], 'build_timestamp': ''})
    data.setdefault('import_metadata', {'source': '', 'imported_at': '', 'source_lms': '', 'items_imported': {'modules': 0, 'objectives': 0, 'assessments': 0, 'activities': 0, 'pages': 0}, 'quality_flags': 0})
    data.setdefault('export_metadata', {'exported_at': '', 'format': '', 'destination': '', 'items_exported': {'modules': 0, 'pages': 0, 'assignments': 0, 'quizzes': 0, 'discussions': 0}, 'failed_items': 0, 'notes': ''})
    qr = data.setdefault('quality_review', {})
    qr.setdefault('cross_domain_checks', {
        'cognitive_load':        {'score': 0, 'flags': []},
        'multimedia_principles': {'score': 0, 'flags': []},
        'feedback_quality':      {'score': 0, 'flags': []},
        'expertise_reversal':    {'score': 0, 'flags': []}
    })
    qr.setdefault('review_history', [])
    data['version'] = '1.1'
    return data

def migrate_1_1_to_1_2(data):
    # Add new sections for skills that now write to manifest
    data.setdefault('red_team_audit', {
        'updated': '',
        'confidence_score': 0,
        'findings_summary': {'critical': 0, 'warning': 0, 'info': 0},
        'dimensions': {},
        'top_actions': [],
        'limitations': []
    })
    data.setdefault('accessibility_review', {
        'updated': '',
        'score': {'overall': 0, 'wcag': 0, 'udl': 0},
        'wcag_violations': [],
        'udl_recommendations': [],
        'quick_wins': []
    })
    # Add readiness_check to export_metadata
    em = data.setdefault('export_metadata', {})
    # Convert failed_items from int (v1.1) to list (v1.2)
    if isinstance(em.get('failed_items'), int):
        em['failed_items'] = []
    em.setdefault('readiness_check', {
        'quality_score': 0,
        'quality_reviewed': False,
        'red_team_critical': 0,
        'red_team_reviewed': False,
        'accessibility_critical': 0,
        'accessibility_reviewed': False,
        'verdict': ''
    })
    # Add quick_wins and recommendations to quality_review
    qr = data.setdefault('quality_review', {})
    qr.setdefault('quick_wins', [])
    qr.setdefault('recommendations', [])
    qr.setdefault('overall_score', 0)
    qr.setdefault('score_breakdown', {
        'qm_structural': 0,
        'coi_presence': 0,
        'constructive_alignment': 0,
        'cross_domain_evidence': 0
    })
    data['version'] = '1.2'
    return data

def migrate_1_2_to_1_3(data):
    # Add preferences section for user configuration
    data.setdefault('preferences', {
        'verbosity': 'normal',
        'export_format': '',
        'preferred_lms': '',
        'auto_advance_pipeline': False
    })
    data['version'] = '1.3'
    return data

def migrate_1_3_to_1_4(data):
    # Schema drift cleanup: rename fields that some pre-v1.4 manifests in the wild
    # used inconsistently (the canonical names live in templates/manifest-schema.md).
    rt = data.get('red_team_audit', {})
    if isinstance(rt, dict):
        # Old shape: red_team_audit.summary.{critical_count, warning_count, info_count}
        # New shape: red_team_audit.findings_summary.{critical, warning, info}
        old_summary = rt.pop('summary', None)
        if isinstance(old_summary, dict):
            fs = rt.setdefault('findings_summary', {'critical': 0, 'warning': 0, 'info': 0})
            for old, new in (('critical_count', 'critical'),
                             ('warning_count',  'warning'),
                             ('info_count',     'info')):
                if old in old_summary and not fs.get(new):
                    fs[new] = old_summary[old]
        # Add the new optional fields introduced in v1.4 (preserve existing values).
        rt.setdefault('focus', '')
        rt.setdefault('report_path', '')
        rt.setdefault('fixes_applied', [])
        rt.setdefault('fixes_deferred', [])
    # Move any legacy _import_quality_flags root field into import_metadata.quality_flag_details.
    legacy_flags = data.pop('_import_quality_flags', None)
    if legacy_flags is not None:
        im = data.setdefault('import_metadata', {})
        # Coerce into list-of-dicts; drop anything that isn't list-shaped.
        details = im.setdefault('quality_flag_details', [])
        if isinstance(legacy_flags, list):
            for item in legacy_flags:
                if isinstance(item, dict):
                    details.append(item)
                else:
                    details.append({'description': str(item)})
    # Ensure quality_flag_details key exists for forward-compat reads.
    im = data.setdefault('import_metadata', {})
    im.setdefault('quality_flag_details', [])
    data['version'] = '1.4'
    return data

# Apply migrations in order
if version == '1.0':
    data = migrate_1_0_to_1_1(data)
    version = '1.1'

if version == '1.1':
    data = migrate_1_1_to_1_2(data)
    version = '1.2'

if version == '1.2':
    data = migrate_1_2_to_1_3(data)
    version = '1.3'

if version == '1.3':
    data = migrate_1_3_to_1_4(data)
    version = '1.4'

if version != '$LATEST_VERSION':
    # Unknown version — output unchanged
    with open(MANIFEST) as f:
        print(f.read(), end='')
    sys.exit(0)

# Write a tempfile and rename it, so a failed write cannot cut the manifest.
# Rename onto the real file, so a symlinked manifest stays a link.
real = os.path.realpath(MANIFEST)
tmp = None
try:
    fd, tmp = tempfile.mkstemp(prefix='.manifest-migrate.', suffix='.tmp',
                               dir=os.path.dirname(real))
    with os.fdopen(fd, 'w') as f:
        json.dump(data, f, indent=2)
        f.write('\n')
    shutil.copymode(real, tmp)
    os.replace(tmp, real)
except Exception as exc:
    if tmp:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    print(f'idstack-migrate: cannot write the manifest {MANIFEST}: {exc}. The manifest did not change.', file=sys.stderr)
    sys.exit(1)

print(json.dumps(data, indent=2))
print(f'MIGRATED {migrated_from} $LATEST_VERSION', file=sys.stderr)
"
