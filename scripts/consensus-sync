#!/usr/bin/env python3
"""Maintainer tool: find candidate citations for the 11 research domains.

Usage: scripts/consensus-sync [--domain <name>] [--dry-run | --no-dry-run | --apply]

It prints candidate evidence/references.md lines for each domain, from the
Consensus cache or the Consensus API (with your key). Without either, it prints
no citation for that domain. It never changes references.md: add the citations
by hand.
Then it runs test/check-evidence-cards.py, so run it from a clone.

This was `idstack-consensus sync`. It is not part of the runtime CLI that the
skills call. It reuses that CLI's key, cache and API helpers by loading
bin/idstack-consensus as a module.
"""

import argparse
import datetime
import hashlib
import importlib.util
import os
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader

_CLI = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "bin", "idstack-consensus")
_loader = SourceFileLoader("idstack_consensus", _CLI)
_cli = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(_cli)

normalize_claim = _cli.normalize_claim
resolve_api_key = _cli.resolve_api_key
get_cached_record = _cli.get_cached_record
save_cached_record = _cli.save_cached_record
fetch_from_consensus_api = _cli.fetch_from_consensus_api
load_known_references = _cli.load_known_references


