#!/usr/bin/env python3
"""
idstack-manifest-merge — atomically replace sections of .idstack/project.json.

Contract:
  Reads the manifest, validates it parses as JSON, replaces ONLY the named
  top-level sections with the supplied payloads (and project_name, when
  --set gives it), updates the top-level "updated" timestamp, and writes
  back once. All other sections (version, created, foreign skill sections,
  and project_name unless --set changes it) are preserved verbatim.
  Every payload is validated before anything is written, so a bad payload
  leaves the manifest (or its absence) unchanged.

  This is section-level REPLACEMENT, not recursive deep-merge — the contract
  is intentionally simple. If you need to merge values within your section,
  read the existing section first and merge in your own code, then pass the
  merged payload here.

Usage:
  idstack-manifest-merge [--create] [--set project_name=<value>]
                         --section <name> --payload <path|->
                         [--section <name> --payload <path|-> ...]
                         [--manifest <path>] [--quiet]

  --section   Top-level section name. Must be one of the whitelisted sections
              defined in the canonical schema. Unknown names exit 3.
  --payload   Path to a JSON file containing the section payload, or "-" to
              read from stdin. Pairs with the --section in the same position;
              repeat the pair to write several sections in one atomic write.
  --set       Set a top-level field. Only project_name. Unknown keys exit 3.
  --create    If the manifest is missing, make a canonical one first
              (scripts/idstack-migrate --init). Without it a missing manifest
              exits 4, which catches a run in the wrong directory.
  --manifest  Path to the manifest. Default: .idstack/project.json
  --quiet     Suppress progress output. Errors still go to stderr.

Exit codes:
  0  success
  1  malformed payload JSON
  2  malformed manifest JSON, or a command-line error (argparse: a missing
     --section or --payload, a count mismatch, a repeated --section, or
     more than one "-" payload)
  3  unknown section name
  4  manifest file not found
  5  payload file not found
  6  i/o error
  7  the manifest is from a newer idstack (its version is above the latest
     version that idstack-migrate knows); nothing is written
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

# Whitelisted top-level sections — must match the canonical schema in
# templates/manifest-schema.md. Adding a new section requires updating both.
ALLOWED_SECTIONS = {
    "context",
    "needs_analysis",
    "learning_objectives",
    "assessments",
    "course_content",
    "import_metadata",
    "export_metadata",
    "quality_review",
    "red_team_audit",
    "accessibility_review",
    "preferences",
}

# Top-level scalar fields that --set may write.
SETTABLE_FIELDS = {"project_name"}

MIGRATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "idstack-migrate")
# idstack-migrate owns the schema version; read it, so the two cannot disagree.
with open(MIGRATE, encoding="utf-8") as _f:
    LATEST_VERSION = re.search(r'^LATEST_VERSION="([0-9.]+)"$', _f.read(), re.M).group(1)


def version_tuple(value):
    """'1.10' -> (1, 10). A missing or malformed version sorts as oldest."""
    try:
        return tuple(int(p) for p in str(value).split("."))
    except ValueError:
        return ()


def parse_args():
    parser = argparse.ArgumentParser(
        description="Replace sections of an idstack manifest with one atomic write.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--section", action="append", required=True, help="The name of a section to replace."
    )
    parser.add_argument(
        "--payload",
        action="append",
        required=True,
        help='The path to the JSON payload file for the --section in the same position. Use "-" for stdin.',
    )
    parser.add_argument(
        "--set", action="append", default=[], metavar="KEY=VALUE", help="Set a top-level field."
    )
    parser.add_argument(
        "--create", action="store_true", help="Make a canonical manifest first if there is none."
    )
    parser.add_argument(
        "--manifest",
        default=".idstack/project.json",
        help="The path to the manifest. Default: .idstack/project.json",
    )
    parser.add_argument("--quiet", action="store_true", help="Show only error messages.")
    args = parser.parse_args()
    if len(args.section) != len(args.payload):
        parser.error("give one --payload for each --section")
    if len(set(args.section)) != len(args.section):
        parser.error("give each --section only one time")
    if args.payload.count("-") > 1:
        parser.error('only one --payload can be "-" (stdin)')
    return args


def die(code, message):
    print(f"idstack-manifest-merge: error: {message}", file=sys.stderr)
    sys.exit(code)


def load_payload(payload_arg):
    if payload_arg == "-":
        try:
            text = sys.stdin.read()
        except Exception as exc:
            die(6, f"cannot read the payload from stdin: {exc}")
    else:
        if not os.path.isfile(payload_arg):
            die(5, f"payload file not found: {payload_arg}")
        try:
            with open(payload_arg, "r", encoding="utf-8") as handle:
                text = handle.read()
        except Exception as exc:
            die(6, f"cannot read the payload file {payload_arg!r}: {exc}")
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        die(1, f"the payload has a JSON error: {exc}")
    if not isinstance(data, dict):
        die(1, f"the payload root must be a JSON object, not {type(data).__name__}")
    return data


def load_manifest(manifest_path):
    if not os.path.isfile(manifest_path):
        die(4, f"manifest not found: {manifest_path}")
    try:
        with open(manifest_path, "r", encoding="utf-8") as handle:
            text = handle.read()
    except Exception as exc:
        die(6, f"cannot read the manifest {manifest_path!r}: {exc}")
    try:
        data = json.loads(text)
    except json.JSONDecodeError as exc:
        die(2, f"the manifest has a JSON error ({manifest_path}): {exc}")
    if not isinstance(data, dict):
        die(2, f"the manifest root must be a JSON object, not {type(data).__name__} ({manifest_path})")
    return data


def create_manifest(manifest_path):
    """Seed a canonical manifest with idstack-migrate --init, so the migrations
    stay the only definition of each section's default."""
    result = subprocess.run(
        [MIGRATE, "--init", manifest_path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )
    if result.returncode != 0 or not os.path.isfile(manifest_path):
        die(6, f"cannot make the manifest {manifest_path!r}: {result.stderr.strip()}")


def write_atomic(manifest_path, data):
    """Write JSON atomically via tempfile + rename, so a crash mid-write
    cannot leave the manifest truncated or partially overwritten."""
    # Rename onto the real file, so a symlinked manifest stays a link.
    real = os.path.realpath(manifest_path)
    tmp_path = None
    try:
        fd, tmp_path = tempfile.mkstemp(prefix=".manifest-merge.", dir=os.path.dirname(real), suffix=".tmp")
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        # mkstemp makes the file 0600. Keep the mode of the manifest.
        shutil.copymode(real, tmp_path)
        os.replace(tmp_path, real)
    except Exception as exc:
        if tmp_path:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        die(6, f"cannot write the manifest {manifest_path!r}: {exc}")


def main():
    args = parse_args()

    for section in args.section:
        if section not in ALLOWED_SECTIONS:
            allowed = ", ".join(sorted(ALLOWED_SECTIONS))
            die(3, f"unknown section {section!r}. The known sections are: {allowed}")

    fields = {}
    for item in args.set:
        key, sep, value = item.partition("=")
        if not sep or key not in SETTABLE_FIELDS:
            known = ", ".join(sorted(SETTABLE_FIELDS))
            die(3, f"unknown --set {item!r}. Use KEY=VALUE with a key from: {known}")
        fields[key] = value

    payloads = [load_payload(path) for path in args.payload]

    created = False
    if args.create and not os.path.isfile(args.manifest):
        create_manifest(args.manifest)
        created = True
    manifest = load_manifest(args.manifest)
    if version_tuple(manifest.get("version")) > version_tuple(LATEST_VERSION):
        die(7, f"the manifest has version {manifest.get('version')}, from a newer idstack than this one "
               f"({LATEST_VERSION}). Update idstack, then run the skill again.")

    for section, payload in zip(args.section, payloads):
        manifest[section] = payload
    manifest.update(fields)
    manifest["updated"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    write_atomic(args.manifest, manifest)

    if not args.quiet:
        if created:
            print(f"idstack made the manifest {args.manifest}")
        for section in args.section:
            print(f"idstack replaced the section {section!r} in {args.manifest}")


if __name__ == "__main__":
    main()
