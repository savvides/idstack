{
  "manifest_version": 3,
  "name": "idstack — Evidence-Based Course Design",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "idstack audits course pages in Canvas LMS, Google Docs and on the web against instructional design evidence.",
  "homepage_url": "https://idstack.org",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open the idstack Course Co-Pilot"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "*://*.instructure.com/*",
    "https://api.consensus.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
