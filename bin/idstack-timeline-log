#!/usr/bin/env bash
# Append one timeline event to .idstack/timeline.jsonl.
# Usage: idstack-timeline-log '{"skill":"course-quality-review","event":"completed","score":72}'
# Injects "ts" field automatically IF the caller did not already supply one.
# A caller-supplied "ts" is preserved verbatim — useful when logging an event
# that occurred at a specific in-conversation moment, not when bash ran.
# Creates .idstack/ if needed. Exit 0 always — never blocks the calling skill.
# Needs python3; without it, it writes nothing and says so on stderr.

set -e

JSON_ARG="${1:-}"
[ -z "$JSON_ARG" ] && exit 0
command -v python3 &>/dev/null || { echo "idstack-timeline-log: python3 is necessary" >&2; exit 0; }

IDSTACK_DIR=".idstack"
TIMELINE="$IDSTACK_DIR/timeline.jsonl"

mkdir -p "$IDSTACK_DIR" 2>/dev/null || exit 0

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Use python3 for safe JSON serialization (injects ts field if absent)
LINE=$(python3 -c "
import json, sys
try:
    d = json.loads(sys.argv[1])
    # Preserve a caller-supplied ts; only mint one if absent.
    d.setdefault('ts', '$TS')
    print(json.dumps(d))
except Exception:
    # Fallback: wrap raw input with timestamp
    print(json.dumps({'raw': sys.argv[1], 'ts': '$TS'}))
" "$JSON_ARG" 2>/dev/null) || LINE="{\"raw\":\"error\",\"ts\":\"$TS\"}"

echo "$LINE" >> "$TIMELINE" 2>/dev/null || true
